generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sessions  Session[]
  accounts  Account[]
  members   Member[]
  invites   Invitation[] @relation("InvitationInviter")
  auditLogs AuditLog[]
  shipmentEvents ShipmentEvent[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  activeOrganizationId String?
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([providerId, accountId])
  @@unique([providerId, accountId])
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier, expiresAt])
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  logo      String?
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  country  String
  currency String
  timezone String
  industry String?

  members        Member[]
  invitations    Invitation[]
  auditLogs      AuditLog[]
  vehicles       Vehicle[]
  drivers        Driver[]
  assignments    VehicleAssignment[]
  shipments      Shipment[]
  shipmentEvents ShipmentEvent[]
  routes         Route[]
  tracking       TrackingPoint[]
  etaPredictions EtaPrediction[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  proofs            ProofOfDelivery[]

  @@index([slug])
}

model Member {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  role           String   @default("member")
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
  @@index([organizationId])
}

model Invitation {
  id             String   @id @default(cuid())
  organizationId String
  email          String
  role           String
  status         String   @default("pending")
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter      User         @relation("InvitationInviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  action         String
  resource       String
  resourceId     String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([organizationId, resource, createdAt])
  @@index([userId])
}

model Vehicle {
  id             String   @id @default(cuid())
  organizationId String
  plateNumber    String
  make           String
  model          String
  year           Int
  type           String   @default("TRUCK")
  status         String   @default("AVAILABLE")
  color          String?
  vin            String?
  fuelType       String?
  fuelCapacity   Float?
  insuranceCompany String?
  insuranceExpiry  DateTime?
  lastServiceAt    DateTime?
  nextServiceAt    DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  VehicleAssignment[]
  tracking     TrackingPoint[]
  etaPredictions EtaPrediction[]

  @@unique([organizationId, plateNumber])
  @@index([organizationId, status])
  @@index([organizationId, type])
}

model Driver {
  id               String   @id @default(cuid())
  organizationId   String
  name             String
  phone            String
  email            String?
  licenseNumber    String
  licenseClass     String?
  licenseExpiry    DateTime
  status           String   @default("AVAILABLE")
  pin              String?
  bloodType        String?
  emergencyContact String?
  nextOfKinName    String?
  nextOfKinPhone   String?
  address          String?
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments  VehicleAssignment[]

  @@unique([organizationId, phone])
  @@unique([organizationId, licenseNumber])
  @@index([organizationId, status])
  @@index([organizationId, licenseExpiry])
}

model VehicleAssignment {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  driverId       String
  status         String   @default("ACTIVE")
  startDate      DateTime @default(now())
  endDate        DateTime?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driver       Driver       @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shipments    Shipment[]

  @@index([organizationId, status])
  @@index([organizationId, vehicleId, status])
  @@index([organizationId, driverId, status])
  @@index([organizationId, startDate])
}

model Shipment {
  id             String   @id @default(cuid())
  organizationId String
  trackingNumber String   @unique
  status         String   @default("PENDING_PICKUP")

  customerName    String
  customerPhone   String?
  customerEmail   String?

  originAddress   String
  originCity      String?
  originLat       Float?
  originLng       Float?
  destinationAddress String
  destinationCity    String?
  destinationLat     Float?
  destinationLng     Float?

  cargoType        String
  cargoDescription String?
  weightKg         Float?
  dimensions       String?
  declaredValue    Float?

  requestedPickupAt    DateTime?
  estimatedDeliverAt   DateTime?
  actualDeliveredAt    DateTime?
  notes                String?
  assignmentId         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  events      ShipmentEvent[]
  proofs      ProofOfDelivery[]
  assignment  VehicleAssignment? @relation(fields: [assignmentId], references: [id], onDelete: SetNull)
  route       Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  etaPredictions EtaPrediction[]

  routeId String? @unique

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, trackingNumber])
  @@index([assignmentId])
}

model ShipmentEvent {
  id             String   @id @default(cuid())
  organizationId String
  shipmentId     String
  eventType      String
  description    String?
  location       String?
  latitude       Float?
  longitude      Float?
  createdById    String?
  createdAt      DateTime @default(now())

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  creator  User?    @relation(fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([shipmentId, createdAt])
  @@index([organizationId, createdAt])
}

model Route {
  id                    String   @id @default(cuid())
  organizationId        String
  name                  String
  waypoints             Json
  totalDistanceKm       Float?
  estimatedDurationMin  Int?
  geometry              Json?
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  shipment      Shipment?

  shipmentId String? @unique

  @@index([organizationId, createdAt])
  @@index([organizationId, name])
}

model TrackingPoint {
  id             String   @id @default(cuid())
  organizationId String
  vehicleId      String
  lat            Float
  lng            Float
  speedKmh       Float?
  headingDeg     Float?
  accuracyM      Float?
  source         String   @default("PWA")
  recordedAt     DateTime @default(now())
  createdAt      DateTime @default(now())

  vehicle      Vehicle      @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, vehicleId, recordedAt])
  @@index([vehicleId, recordedAt])
  @@index([organizationId, recordedAt])
}

model EtaPrediction {
  id             String    @id @default(cuid())
  organizationId String
  shipmentId     String
  vehicleId      String?
  status         String
  predictedAt    DateTime  @default(now())
  remainingKm    Float?
  predictedMinutes Int?
  etaAt          DateTime?
  speedUsedKmh   Float?
  isDelayed      Boolean   @default(false)
  actualDeliveredAt DateTime?

  shipment     Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  vehicle      Vehicle?     @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, shipmentId, predictedAt])
  @@index([shipmentId, predictedAt])
  @@index([organizationId, vehicleId, predictedAt])
}

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  type           String
  title          String
  body           String?
  link           String?
  read           Boolean  @default(false)
  channel        String   @default("IN_APP")
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, read])
}

model NotificationPreference {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  shipmentStatus Boolean  @default(true)
  vehicleAlert   Boolean  @default(true)
  driverAlert    Boolean  @default(true)
  systemAlert    Boolean  @default(true)
  email          Boolean  @default(false)
  sms            Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model ProofOfDelivery {
  id             String   @id @default(cuid())
  organizationId String
  shipmentId     String
  photos         Json     @default("[]")
  signature      String?
  recipientName  String
  recipientPhone String?
  notes          String?
  locationLat    Float?
  locationLng    Float?
  capturedByName String?
  capturedAt     DateTime @default(now())

  shipment     Shipment     @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@index([organizationId, capturedAt])
}
